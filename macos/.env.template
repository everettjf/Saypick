# Saypick macOS release environment
#
# The release scripts do not source this file. Export these values in the shell
# that runs scripts/release-macos.sh or macos/scripts/build-release.sh.

export APPLE_ID="your-email@example.com"
export APPLE_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"
export APPLE_TEAM_ID="ABC1234567"

# The Developer ID Application certificate and its private key must be installed
# in the login Keychain. The scripts select the matching identity by APPLE_TEAM_ID.
